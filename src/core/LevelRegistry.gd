class_name LevelRegistry
extends RefCounted
## Single source of truth for level scenes + state labels.
## Decoupled replacement for legacy `scripts/Fases.gd` (PT-BR).
## New code should use this; Fases.gd stays as a thin shim.
##
## The label VALUES are PT-BR on purpose: they are the only user-facing strings
## the player reads (Hud's status chip), and the HUD also shows PT-BR sensor
## and attempt text. Mixing "STATUS: Seeking spot" with "SENSOR: Obstáculo à
## frente" in one panel was the reported confusion. The KEYS stay English
## (canonical `VehicleState` names) so lookups stay language-independent.

const LEVELS := [
	"res://scenes/fases/Fase1.tscn",
	"res://scenes/fases/Fase2.tscn",
	"res://scenes/fases/Fase3.tscn",
	"res://scenes/fases/Fase4.tscn",
	"res://scenes/fases/Fase5.tscn",
	# Generated by `tools/gen_level.py` from `tools/specs/*.json`: the stall
	# grid is DERIVED from the car footprint, so a bay can never overlap its
	# neighbour (that defect class is what broke Fase5 — 89 bays on a 38 px
	# pitch, zero reachable).
	"res://scenes/fases/Fase6.tscn",
	"res://scenes/fases/Fase7.tscn",
	# Fase8/Fase9 add the two difficulty axes the tests were missing: a
	# PERPENDICULAR crossing car in a wide lot, and staggered interior walls
	# that force a serpentine route (a maze the A* has to solve).
	"res://scenes/fases/Fase8.tscn",
	"res://scenes/fases/Fase9.tscn",
	# Fase10 (S6): the STRESS level — bays of the middle row sit BETWEEN two
	# staggered central refuges (the only approach runs through their shadow),
	# and the crossing car cuts north-south through the aisle. Generated by
	# tools/gen_level.py from tools/specs/Fase10.json like Fase6..9.
	"res://scenes/fases/Fase10.tscn",
	# Fase11 (TRAZEGO, docs/tasks_trafego.md): the TRANSIT level — a wide open
	# aisle with the dynamic actors the other levels never had: pedestrians
	# walking between the stall columns (the car YIELDS), tires rolling across
	# the lane (the car DODGES — solid, layer 2) and an ACCIDENT car that
	# stalls ON the aisle centre (blocked_ahead -> detour -> replan). Key P.
	"res://scenes/fases/Fase11.tscn",
]

## PT-BR display names, index-aligned with LEVELS (level-select HUD).
const LEVEL_NAMES := [
	"1 · Lote norte-sul",
	"2 · Corredor largo",
	"3 · Lote escalado",
	"4 · Baias paralelas",
	"5 · Lote grande",
	"6 · Aisle duplo",
	"7 · Grade 3 fileiras",
	"8 · Cruzamento",
	"9 · Labirinto",
	"10 · Estresse",
	"11 · Trânsito",
]

const DEMO_SCENE := "res://scenes/Mundo.tscn"

const STATE_LABELS := {
	"SEEKING": "Procurando vaga",
	"AVOIDING": "Desviando de obstáculo",
	"ALIGNING": "Alinhando para estacionar",
	"PARKED": "Estacionado",
	"RECOVERING": "Recuperando...",
	# Legacy PT-BR keys stay readable so old signal payloads still resolve.
	"BUSCANDO": "Procurando vaga",
	"DESVIANDO": "Desviando de obstáculo",
	"ALINHANDO": "Alinhando para estacionar",
	"ESTACIONADO": "Estacionado",
	"RECUPERANDO": "Recuperando...",
}

## Colour per state for the HUD's status chip (presentation only).
const STATE_COLORS := {
	"SEEKING": Color(0.98, 0.85, 0.35),
	"AVOIDING": Color(1.0, 0.45, 0.35),
	"ALIGNING": Color(0.45, 0.78, 1.0),
	"PARKED": Color(0.35, 0.92, 0.5),
	"RECOVERING": Color(0.85, 0.6, 1.0),
}

## Same keys as STATE_LABELS, so a lookup never has to translate a name.
const _STATE_KEYS := ["SEEKING", "AVOIDING", "ALIGNING", "PARKED", "RECOVERING"]


## Canonical key for a state payload of ANY shape: a `VehicleState.State`
## int (English facade `state_changed`), a legacy PT-BR name
## (`Carro.estado_mudou`) or a display label (`VehicleState.label()`).
## Returns "SEEKING" when nothing matches, so the HUD always has a key.
static func state_key(payload: Variant) -> String:
	if payload is int:
		return VehicleState.to_legacy_name(int(payload))
	var raw := str(payload)
	if STATE_LABELS.has(raw):
		return raw
	for state in VehicleState.LABELS:
		if str(VehicleState.LABELS[state]) == raw:
			return VehicleState.to_legacy_name(int(state))
	return "SEEKING"


## PT-BR text for a state payload of any shape (see `state_key`).
static func state_text(payload: Variant) -> String:
	return str(STATE_LABELS.get(state_key(payload), "Procurando vaga"))


## `_STATE_KEYS` is in `VehicleState.State` order, so index i IS the enum.
static func state_color(payload: Variant) -> Color:
	var key := state_key(payload)
	for i in range(_STATE_KEYS.size()):
		if _STATE_KEYS[i] == key or VehicleState.to_legacy_name(i) == key:
			return STATE_COLORS[_STATE_KEYS[i]]
	return Color(1, 1, 1)


## Best Line2D route for the vehicle (fallback when A* is unavailable).
## `routes_node` holds the Line2D lanes, `vehicle_position` and `spots`
## are only used to score each candidate route.
static func collect_route_points(routes_node: Node, vehicle_position: Vector2, spots: Node) -> Array:
	if routes_node == null:
		return []
	var best: Array = []
	var best_score: float = INF
	var spot_target: Vector2 = Vector2.INF
	if spots != null and spots.get_children().size() > 0:
		for spot in spots.get_children():
			var taken: bool = bool(spot.get("is_occupied")) or bool(spot.get("ocupada"))
			if not taken:
				spot_target = (spot as Node2D).global_position
				break
		if spot_target == Vector2.INF:
			spot_target = (spots.get_child(0) as Node2D).global_position
	for child in routes_node.get_children():
		if not child is Line2D:
			continue
		var pts: PackedVector2Array = child.points
		if pts.size() < 2:
			continue
		var glob: Array = []
		for p in pts:
			glob.append(child.to_global(p))
		var d_start: float = vehicle_position.distance_to(glob[0]) if glob.size() > 0 else INF
		var d_end: float = spot_target.distance_to(glob[glob.size() - 1]) if glob.size() > 0 and spot_target != Vector2.INF else INF
		var score: float = d_start * 0.6 + d_end * 0.4
		if score < best_score:
			best_score = score
			best = glob
	if not best.is_empty():
		return best
	var all_points: Array = []
	for child in routes_node.get_children():
		if child is Line2D:
			for p in child.points:
				all_points.append(child.to_global(p))
	return all_points
